EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 화면에 보일 로그인 방법(설정을 마친 것만). apple,kakao,google,email
EXPO_PUBLIC_LOGIN_METHODS=apple,email
# iOS Google 지도 SDK 키. 앱 번들 ID/API 제한을 걸고 네이티브 재빌드가 필요함.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# 결제 전 유료 기능을 확인하는 시험 빌드에서만 1. 출시용은 비워 둠.
EXPO_PUBLIC_PAID_PREVIEW=
